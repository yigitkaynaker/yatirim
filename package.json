{
  "name": "yatirim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "test:ai": "node --conditions=react-server --import ./scripts/ts-hooks.mjs scripts/test-ai.ts",
    "test:indicators": "node --import ./scripts/ts-hooks.mjs scripts/test-indicators.ts",
    "test:fx": "node --import ./scripts/ts-hooks.mjs scripts/test-fx.ts",
    "test:sources": "node --import ./scripts/ts-hooks.mjs scripts/test-sources.ts",
    "test:batchb": "node --conditions=react-server --import ./scripts/ts-hooks.mjs scripts/test-batchb.ts",
    "test:batchc": "node --conditions=react-server --import ./scripts/ts-hooks.mjs scripts/test-batchc.ts",
    "test:concurrency": "node --conditions=react-server --import ./scripts/ts-hooks.mjs scripts/test-concurrency.ts",
    "test:users": "node --conditions=react-server --import ./scripts/ts-hooks.mjs scripts/test-users.ts",
    "test:ollama": "node --conditions=react-server --import ./scripts/ts-hooks.mjs scripts/test-ollama.ts",
    "test:help": "node --conditions=react-server --import ./scripts/ts-hooks.mjs scripts/test-help.ts",
    "test:video": "node --import ./scripts/ts-hooks.mjs scripts/test-video.ts",
    "test:catalog": "node --conditions=react-server --import ./scripts/ts-hooks.mjs scripts/test-catalog.ts",
    "test:pg": "node scripts/run-pg-tests.mjs",
    "db:migrate": "node --env-file-if-exists=.env.bulut --import ./scripts/ts-hooks.mjs scripts/db-migrate.ts",
    "geri-yukle:json": "node --env-file-if-exists=.env.bulut --import ./scripts/ts-hooks.mjs scripts/geri-yukle-json.ts",
    "tasi:neon": "node --env-file-if-exists=.env.bulut --import ./scripts/ts-hooks.mjs scripts/tasi-neon.ts",
    "pg:dev": "node scripts/pg-dev-server.mjs",
    "vercel-build": "node --import ./scripts/ts-hooks.mjs scripts/db-migrate.ts && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lightweight-charts": "^5.3.0",
    "next": "^16.4.6",
    "openai": "^7.62.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0",
    "yahoo-finance2": "^4.0.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
