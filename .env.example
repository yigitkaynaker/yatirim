# Giriş şifresi (tek kullanıcı)
APP_PASSWORD=degistir123
# Oturum çerezini imzalamak için uzun, rastgele bir değer (en az 32 karakter)
SESSION_SECRET=buraya-uzun-rastgele-bir-deger-yazin
# Claude API anahtarı (isteğe bağlı; Ayarlar sayfasından da eklenebilir, ikisi varsa bu önceliklidir)
ANTHROPIC_API_KEY=

# ---- Yalnızca BULUT MODU (Vercel + Neon). Yerel kullanımda BOŞ bırakın! -----------------
# DATABASE_URL doluysa uygulama yerel SQLite yerine Neon'u kullanır (bkz. BULUT.md).
# Neon havuzlu (pooled, adında "-pooler" geçen) bağlantı adresi — uygulama bunu kullanır
DATABASE_URL=
# Neon doğrudan (havuzsuz) bağlantı adresi — db:migrate ve tasi:neon bunu kullanır
DATABASE_URL_UNPOOLED=
# Nöbet uçlarının gizli anahtarı (en az 16 karakter; cron-job.org ve GitHub'a aynı değer girilir)
CRON_SECRET=
